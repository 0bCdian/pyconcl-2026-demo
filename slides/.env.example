# URL de la arena que abren los celulares (el QR de la portada y de las demos); la imprime `make tunnel`
VITE_ARENA_URL=https://ejemplo.trycloudflare.com
# URL del repositorio para el QR del cierre
VITE_REPO_URL=https://github.com/usuario/pycon-cl-2026
# Grafana para los paneles en vivo; por defecto, el de `make proxy`
# VITE_GRAFANA_URL=http://localhost:8001/api/v1/namespaces/monitoring/services/kps-grafana:80/proxy
# Pantalla del proyector de la arena (/screen), con el token de admin en la URL; la usan los eventos en vivo
# VITE_ARENA_SCREEN_URL=http://192.168.1.10:8080/screen?token=...
